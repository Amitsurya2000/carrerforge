# CareerForge — required environment variables (copy to .env and fill in)
# The host (Render/Vercel) sets PORT automatically; only set it locally.
PORT=3456

# Gemini — PRIMARY brain. Get a real AIza... key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek — optional fallback (used only if GEMINI_API_KEY is empty)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gathos — AI cover images + voice (optional)
GATHOS_BASE_URL=https://gathos.com/api/v1
GATHOS_IMAGE_API_KEY=
GATHOS_I2I_API_KEY=
GATHOS_TTS_API_KEY=

# Path to Chromium (Docker sets this to /usr/bin/chromium automatically)
CHROME_PATH=

# Supabase — stores customer details (name, email, phone, target, etc.)
# Project Settings → API: copy the URL and the service_role key (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
